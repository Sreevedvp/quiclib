{
  "name": "quic-fleet-live",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b vendor/protocol vendor/web && tsc --noEmit -p frontend && vite build frontend && cargo build --manifest-path server/Cargo.toml",
    "test": "vitest run && cargo test --manifest-path server/Cargo.toml",
    "start": "cd server && cargo run -- --production",
    "test:browser": "node scripts/browser-test.mjs",
    "format": "prettier --write frontend/src scripts",
    "build:benchmark": "tsc -b vendor/protocol vendor/web && tsc --noEmit -p frontend && vite build frontend && cargo build --release --manifest-path server/Cargo.toml",
    "compare": "node scripts/compare.mjs",
    "test:transports": "node scripts/check-transports.mjs",
    "open:comparison": "node scripts/open-comparison.mjs"
  },
  "dependencies": {
    "@quiclib/web": "workspace:*",
    "@quiclib/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "2.1.9",
    "@types/node": "22.18.6",
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  }
}
